{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "maxPollingInterval": "00:00:15",
      "visibilityTimeout": "00:00:10",
      "batchSize": 12,
      "maxDequeueCount": 4,
      "newBatchThreshold": 4
    }
  },
  "logging": {
    "fileLoggingMode": "debugOnly",
    "logLevel": {
      "default": "None",
      "Function.BlobQueueEventFunction": "Information",
      "Function.BlobQueueEventFunction.User": "Information",
      "Function.PaymentPositionDequeueFunction": "Information",
      "Function.PaymentPositionDequeueFunction.User": "Information",
      "Worker": "Information",
      "Host.Results": "Error",
      "Host.Aggregator": "Error",
      "Host": "Error",
      "Microsoft": "Warning",
      "com.microsoft": "Warning",
      "com.azure": "Warning"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 5,
        "includedTypes": "PageView;Trace;Dependency;Request",
        "excludedTypes": "Exception;Event;CustomEvent"
      }
    }
  }
}